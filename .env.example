# Environment
APP_ENV=local
LOG_LEVEL=INFO

# Storage Backend (local | s3)
STORAGE_BACKEND=local
LOCAL_LAKE_DIR=./data/lake

# PostgreSQL 16 Alpine (Core Operational & Gold Warehouse)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=deliveryops
POSTGRES_USER=deliveryops
POSTGRES_PASSWORD=deliveryops_local_dev

# Redpanda (Kafka-Compatible Event Streaming)
REDPANDA_BROKERS=localhost:19092

# MinIO (S3-Compatible Object Storage)
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_local_dev
MINIO_BUCKET_BRONZE=deliveryops-bronze
MINIO_BUCKET_SILVER=deliveryops-silver
MINIO_BUCKET_GOLD=deliveryops-gold

# DuckDB Analytical Engine Resource Limits (Tuned for 4C/8T & 16GB Host RAM)
DUCKDB_MEMORY_LIMIT=1GB
DUCKDB_THREADS=2

# OpenTelemetry & Jaeger
OTEL_SERVICE_NAME=deliveryops-intelligence
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
JAEGER_UI_PORT=16686

# Serving Layer
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
STREAMLIT_PORT=8501
